# Admin panel
ADMIN_PASSWORD=change-me
SESSION_SECRET=a-long-random-string
# Supabase: Project Settings > Database > Connection string > Transaction pooler (URI)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# Vercel Blob (added automatically when you connect a Blob store to the project)
BLOB_READ_WRITE_TOKEN=
# Razorpay (use rzp_test_ keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_WHATSAPP=919345145774
